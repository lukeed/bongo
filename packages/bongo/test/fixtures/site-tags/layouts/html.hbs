<!doctype html>
<html>
<head><title>{{ $page.title }}</title></head>
<body>
<section data-tags="{{#each $page.tags as (t, i)}}{{#if i}},{{/if}}{{ t }}{{/each}}">
{{{ $page.content }}}
</section>
<ul class="tag-pages">
{{#each $tags as (entry)}}
<li data-tag="{{ entry.tag }}">{{#each entry.pages as (p)}}<span data-path="{{ p.path }}">{{ p.title }}</span>{{/each}}</li>
{{/each}}
</ul>
</body>
</html>
