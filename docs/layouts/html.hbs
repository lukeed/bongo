{{#var docs = !!$page.params.group}}
{{#var home = $page.path === '/'}}
{{#var title = home ? 'bongo · Static sites with a good beat' : $page.title + ' · bongo'}}
{{#var summary = $utils.plain($page.summary || $site.description)}}
{{#var lost = $page.path === '/404.html'}}
{{#var card = docs && $utils.url.abs(await $assets.render('og/card'))}}
{{#var alt = docs ? $page.title + ', in the bongo docs' : 'bongo: static sites with a good beat.'}}
<!doctype html>
<html lang="{{ $site.lang }}">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<script>document.documentElement.dataset.theme=localStorage.getItem("theme")||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light")</script>
	<title>{{ title }}</title>
	<meta name="description" content="{{ summary }}"/>
	{{#if lost}}
	<meta name="robots" content="noindex"/>
	{{#else}}
	<link rel="canonical" href="{{ $page.url }}"/>
	{{/if}}
	{{#if docs}}
	<bongo:alternate type="text/markdown" />
	{{/if}}
	<meta property="og:type" content="website"/>
	<meta property="og:site_name" content="bongo"/>
	<meta property="og:title" content="{{ title }}"/>
	<meta property="og:description" content="{{ summary }}"/>
	<meta property="og:url" content="{{ $page.url }}"/>
	<meta property="og:image" content="{{#if card}}{{ card }}{{#else}}{{ new URL($site.url).origin }}<bongo:asset src='img/og.png' />{{/if}}"/>
	<meta property="og:image:type" content="image/png"/>
	<meta property="og:image:width" content="1200"/>
	<meta property="og:image:height" content="630"/>
	<meta property="og:image:alt" content="{{ alt }}"/>
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:image:alt" content="{{ alt }}"/>
	<meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFDF7"/>
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212"/>
	<link rel="icon" type="image/svg+xml" href="<bongo:asset src='img/favicon.svg' />"/>
	<link rel="apple-touch-icon" href="<bongo:asset src='img/touch.png' />"/>
	<bongo:asset preload src="fonts/space-grotesk.woff2" />
	<bongo:asset preload src="fonts/unbounded.woff2" />
	<bongo:style src="style.css"></bongo:style>
</head>
<body{{#if home}} class="home"{{/if}}>
{{#partial src="header"}}
{{{ $page.content }}}
{{#partial src="search"}}
<bongo:client transitions prefetch />
<bongo:script src="main.ts"></bongo:script>
</body>
</html>
