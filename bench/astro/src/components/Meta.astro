---
import { date } from '../lib';

let { date: value, tags } = Astro.props as { date: Date; tags: string[] };
---
<p class="meta">
	<time datetime={value.toISOString().slice(0, 10)}>{date(value)}</time>
	{tags.length > 0 && <span class="tags">{tags.map(tag => <span class="tag">{tag}</span>)}</span>}
</p>
