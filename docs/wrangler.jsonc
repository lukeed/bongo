{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bongo-docs",
	"compatibility_date": "2026-10-13",
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "bongo.build", "custom_domain": true }
	]
}
