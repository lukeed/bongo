{{#expect href}}
<div class="copy-page">
	<button class="cp-main" type="button" data-copy-page="{{ href }}">
		<svg class="cp-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"/></svg>
		<svg class="cp-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
		<span class="cp-label" aria-live="polite"><span>Copy page</span><span>Copied</span></span>
	</button>
	<button class="cp-more" type="button" data-copy-menu aria-haspopup="menu" aria-expanded="false" aria-controls="cp-menu" aria-label="More ways to read this page">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
	</button>
	<div class="cp-menu" id="cp-menu" role="menu" hidden>
		<button type="button" role="menuitem" data-copy-page="{{ href }}">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"/></svg>
			<span><b>Copy as Markdown</b><small>Paste this page into an AI tool.</small></span>
		</button>
		<a href="{{ href }}" target="_blank" rel="noopener" role="menuitem">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 15V9l2.5 3L12 9v6M16 9v6M14 13l2 2 2-2"/></svg>
			<span><b>View as Markdown</b><small>Open this page as plain text.</small></span>
		</a>
	</div>
</div>
