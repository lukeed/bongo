{{#var docs = $page.section === 'docs'}}
{{#var version = $data.release.version}}
<header class="top">
	<div class="top-in">
		<a class="brand" href="/" aria-label="bongo home">{{#partial src="wordmark"}}</a>
		<a class="ver" href="https://github.com/lukeed/bongo/releases/tag/v{{ version }}">v{{ version }}</a>
		{{#if docs}}
		<button class="search" type="button" data-search>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
			<span>Search docs</span><kbd>⌘K</kbd>
		</button>
		{{/if}}
		<nav class="links" aria-label="Main">
			<a href="/docs/"{{#if docs}} aria-current="true"{{/if}}>Docs</a>
			<a href="/docs/markdown/">Plugins</a>
			{{#if docs}}
			<button class="icon only-m" type="button" data-search aria-label="Search docs">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
			</button>
			{{/if}}
			<a class="icon" href="https://github.com/lukeed/bongo" aria-label="bongo on GitHub" style="--s1:var(--s3)">
				<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
			</a>
			<button class="icon" type="button" data-theme-toggle aria-label="Switch theme" style="--s1:var(--s2)">
				<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
				<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
			</button>
		</nav>
	</div>
</header>
