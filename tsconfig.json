{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2019",
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "removeComments": true,
    "sourceMap": false,
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "ssg": ["./index.d.ts", "./index.js"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "/index.js"
  ]
}
