{
  "version": "1.2.0",
  "name": "@bongo/markdown",
  "description": "Markdown loader for bongo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeed/bongo.git",
    "directory": "packages/plugin.markdown"
  },
  "types": "index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./highlight": {
      "types": "./highlight.d.ts",
      "default": "./highlight.js"
    },
    "./twinkleplop": {
      "types": "./twinkleplop.d.ts",
      "default": "./twinkleplop.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "highlight.js",
    "highlight.d.ts",
    "twinkleplop.js",
    "twinkleplop.d.ts"
  ],
  "author": {
    "name": "Luke Edwards",
    "email": "luke.edwards05@gmail.com",
    "url": "https://lukeed.com"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "md4x": "^0.0.30"
  },
  "devDependencies": {
    "@twinkleplop/bash": "^0.1.7",
    "@twinkleplop/markdown-core": "^0.2.1",
    "@twinkleplop/theme-github": "^0.2.4",
    "@twinkleplop/typescript": "^0.1.7",
    "shiki": "^4.5.0",
    "sugar-high": "^2.6.0"
  },
  "peerDependencies": {
    "@twinkleplop/markdown-core": ">=0.2.0",
    "shiki": ">=4.0.0",
    "sugar-high": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@twinkleplop/markdown-core": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "sugar-high": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}