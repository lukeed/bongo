{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2024",
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "removeComments": true,
    "sourceMap": false,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "bongo": [
        "./packages/bongo/index.d.ts"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "bench",
    "docs",
    "packages"
  ],
  "exclude": [
    "**/node_modules/**",
    "archive/**",
    "docs/public/**",
    "bench/site/public/**",
    "bench/astro/**",
    "packages/**/*.js",
    "packages/create-bongo/template/**",
    "packages/bongo/test/fixtures/site-build-error/**"
  ]
}
